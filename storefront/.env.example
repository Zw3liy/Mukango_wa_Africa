# Mukango Wa Africa — Environment Configuration Template
# NOTE: Never commit production credentials, database passwords, or secrets to version control.

# Canonical Site URL (Required for production SEO sitemap and canonical links)
SITE_URL=https://mukangowaafrica.com

# Authoritative Currency
DEFAULT_CURRENCY=USD

# Payment Gateway: Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payment Gateway: PayFast (South Africa / Regional African Gateway)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Bank Wire / SWIFT Payment Instructions (Required for Wire / Pro-Forma Orders)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_SWIFT_CODE=

# Transactional Email & Enquiries Delivery (Resend / SMTP)
RESEND_API_KEY=re_...
CONTACT_RECEIVER_EMAIL=enquiries@mukangowaafrica.com
EMAIL_FROM=Mukango Wa Africa <orders@mukangowaafrica.com>

# Durable PostgreSQL Order & Webhook Store
DATABASE_URL=postgresql://user:password@host:5432/mukango_production

# Node Environment
NODE_ENV=production
