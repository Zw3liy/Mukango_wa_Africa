# Mukango Wa Africa — Production Environment Configuration Template
# NOTE: Never commit production credentials, database passwords, or secret keys to version control.

# ==============================================================================
# 1. Canonical Site URL & SEO Metadata
# ==============================================================================
# Canonical public domain URL (Required for absolute URLs, sitemap.xml, and Stripe/PayFast redirects)
SITE_URL=https://mukangoafrica.co.za

# ==============================================================================
# 2. Authoritative Atelier Currency
# ==============================================================================
# Authoritative base currency for Mukango Wa Africa transactions.
# Primary default: ZAR (South African Rand). Supported: ZAR, USD, EUR, GBP, ZMW.
DEFAULT_CURRENCY=ZAR

# ==============================================================================
# 3. Durable PostgreSQL Database Store
# ==============================================================================
# PostgreSQL connection string for durable order storage and webhook idempotency tracking.
# Production examples:
# - Neon / Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require
# - Railway / AWS RDS: postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB]
# - Local Dev / CI: postgresql://postgres:postgres@localhost:5432/mukango_production
DATABASE_URL=postgresql://user:password@host:5432/mukango_production

# ==============================================================================
# 4. Payment Gateway: PayFast (South Africa & Regional SADC Instant EFT / Card)
# ==============================================================================
# Live credentials from https://www.payfast.co.za dashboard:
# PAYFAST_MERCHANT_ID: Your 8-digit live merchant ID (e.g. 10000100 in sandbox)
# PAYFAST_MERCHANT_KEY: Your 32-character merchant key
# PAYFAST_PASSPHRASE: Security passphrase configured in PayFast account settings
# PAYFAST_SANDBOX: Set to 'false' in production, 'true' for sandbox testing
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# ==============================================================================
# 5. Payment Gateway: Stripe (International Credit & Debit Cards)
# ==============================================================================
# Live credentials from https://dashboard.stripe.com:
# STRIPE_SECRET_KEY: Live secret key starting with 'sk_live_' (or 'sk_test_' in staging)
# STRIPE_PUBLISHABLE_KEY: Live publishable key starting with 'pk_live_'
# STRIPE_WEBHOOK_SECRET: Signing secret starting with 'whsec_' configured in Stripe Webhooks
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# 6. Official SWIFT & Bank Wire Coordinates (Pro-Forma Invoices)
# ==============================================================================
# Verified corporate banking coordinates issued on commercial pro-forma invoices.
# These values are STRICTLY configuration-driven: with no values configured the
# wire/checkout boundary fails closed and no banking details are ever fabricated.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_SWIFT_CODE=

# ==============================================================================
# 7. Transactional Email & Enquiries Delivery (Resend API)
# ==============================================================================
# API key from https://resend.com (must start with 're_'):
RESEND_API_KEY=re_...
CONTACT_RECEIVER_EMAIL=enquiries@mukangoafrica.co.za
EMAIL_FROM=Mukango Wa Africa <orders@mukangoafrica.co.za>

# Optional alternative SMTP transport (used only when RESEND_API_KEY is absent):
SMTP_HOST=
SMTP_USER=

# ==============================================================================
# 8. Newsletter Registry & Verified Buyer Reviews
# ==============================================================================
# Server-side HTTPS endpoints. Secrets are never exposed to the browser bundle.
NEWSLETTER_SUBSCRIBE_URL=
NEWSLETTER_API_KEY=
VERIFIED_REVIEWS_API_URL=
VERIFIED_REVIEWS_API_KEY=

# ==============================================================================
# 9. Node Runtime Environment
# ==============================================================================
NODE_ENV=production

# Development/test ONLY: permits the in-memory order store fallback when no
# DATABASE_URL is configured. NEVER enable this in production — durable
# PostgreSQL storage is mandatory for live commerce.
# ALLOW_TEST_MEMORY_STORE=true
