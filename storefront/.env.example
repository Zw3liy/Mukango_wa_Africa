# Mukango Wa Africa — Environment Configuration Template
# NOTE: Never commit production credentials or secrets to version control.

# Canonical Site URL (Required for production SEO sitemap and canonical links)
SITE_URL=https://mukangowaafrica.com

# Payment Provider Configuration (At least one provider required for live checkout)
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayFast (South Africa / Regional African gateway)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Transactional Email & Enquiries Delivery
RESEND_API_KEY=re_...
CONTACT_RECEIVER_EMAIL=enquiries@mukangowaafrica.com
EMAIL_FROM=Mukango Wa Africa <orders@mukangowaafrica.com>

# Durable Order Store / Database
DATABASE_URL=postgresql://user:password@host:5432/mukango_production

# Node Environment
NODE_ENV=production
